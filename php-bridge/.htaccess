# Evitar que se listen los archivos del directorio
Options -Indexes

# Bloquear acceso HTTP directo a archivos sensibles
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

<Files "test_capabilities.php">
    Order Allow,Deny
    Deny from all
</Files>

# Solo email.php es accesible públicamente
<Files "email.php">
    Order Allow,Deny
    Allow from all
</Files>
